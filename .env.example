# Copy to .env to override the development defaults used by compose.yaml.
# All values are fictional and must be replaced before deployment.
POSTGRES_DB=finance_tracker
POSTGRES_USER=finance_tracker_app
POSTGRES_PASSWORD=fictional-postgres-password

JWT_ISSUER=finance-tracker
JWT_AUDIENCE=finance-tracker-web
JWT_SECRET=fictional-development-jwt-secret-change-before-deployment
JWT_ACCESS_TOKEN_TTL=15m

CORS_ALLOWED_ORIGINS=http://localhost:8080
MAX_REQUEST_SIZE=2MB
MAX_CSV_FILE_SIZE=1MB
MAX_CSV_ROWS=10000
MAX_REQUEST_HEADER_SIZE=16KB
REGISTRATION_MAX_ATTEMPTS=5
REGISTRATION_WINDOW=1m

FRONTEND_PORT=8080
